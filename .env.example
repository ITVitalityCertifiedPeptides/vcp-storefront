# Swell storefront (frontend/public) API credentials.
# The public key is safe to expose in client-side code by design - it is
# NOT the secret/backend API key used by the import scripts in the Peptides
# folder, and it does not grant write access.
#
# Find these in the Swell admin under Settings > API.
NEXT_PUBLIC_SWELL_STORE_ID=vitality-certified-peptides
NEXT_PUBLIC_SWELL_PUBLIC_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Swell Backend API secret key. Server-side only, never NEXT_PUBLIC - used
# by the order-paid/subscribe routes, and (2026-09-05) by
# src/lib/swell-account-verify.ts to confirm a real account before
# minting a GLP-1 session cookie. Find it in the Swell admin under
# Settings > API > Secret Key. Already set in Vercel; only missing here
# if you're running this app locally for the first time.
SWELL_SECRET_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Signs this app's GLP-1 login-gate cookie (src/lib/session.ts). Any long
# random string, e.g. `openssl rand -base64 32` - NOT shared with Inner
# Circle's or Wholesale's own SESSION_SECRET.
SESSION_SECRET=
